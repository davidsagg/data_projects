# VeloDNA — copie para `.env` e preencha. O `.env` nunca é versionado.

# --- Banco e dados ------------------------------------------------------
DB_PATH=data/velodna.duckdb
FIT_DATA_DIR=data/fit
GPX_DATA_DIR=data/gpx

# --- IA local (Ollama) --------------------------------------------------
OLLAMA_HOST=http://localhost:11434

# --- Strava -------------------------------------------------------------
# Crie a aplicação em https://www.strava.com/settings/api
# ("Authorization Callback Domain" precisa ser exatamente `localhost`).
# Depois rode: .venv/bin/python scripts/authorize_strava.py
# O refresh token passa a viver em ~/.velodna/strava_token.json, porque o
# Strava o rotaciona a cada renovação e um valor fixo no .env vira lixo.
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# --- Garmin Connect -----------------------------------------------------
GARMIN_EMAIL=
GARMIN_PASSWORD=

# --- MLflow -------------------------------------------------------------
MLFLOW_TRACKING_URI=sqlite:///mlflow/mlflow.db
